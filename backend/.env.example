# Written by deploy/install.sh — every value can be edited later (then: systemctl restart aw-wallet aw-wallet-worker)
BOT_TOKEN=123456:ABC...
BOT_USERNAME=aw_wallet_bot
WEBAPP_URL=https://wallet.example.com
WEBHOOK_SECRET=random-64-hex
SESSION_SECRET=random-64-hex
SECRETS_KEY=random-64-hex            # encrypts the master seed file and sensitive fields — back it up with the seed!
ADMIN_IDS=111111111                  # comma-separated Telegram ids of owners
ADMIN_CHANNEL_ID=                    # optional: alerts chat id (-100…)
ANTHROPIC_API_KEY=                   # optional: enables AW AI (Claude)
AI_MODEL=claude-opus-5-5
# Optional chain providers (public endpoints are used when empty)
RPC_ETH=
RPC_BSC=
RPC_POLYGON=
RPC_ARBITRUM=
RPC_BASE=
RPC_AVAX=
RPC_SOL=
TRON_API_KEY=
TONCENTER_API_KEY=
